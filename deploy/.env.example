# Copy to deploy/.env on the VPS and fill in real values. Never commit
# deploy/.env -- gitignored. hermes/config.py raises MissingConfigError
# rather than falling back to a placeholder (Section B instruction 4).

# --- Telegram bridge (Section 6: deliberately a DIFFERENT bot/token from
# the trading instance's, so notifications are distinguishable) ---
QUINTA55_TELEGRAM_BOT_TOKEN=
QUINTA55_TELEGRAM_CHAT_ID=

# --- Claude Code headless auth (Section 5) ---
ANTHROPIC_API_KEY=

# --- Per-role model overrides ---
# MODEL_RESEARCH=claude-haiku-4-5-20251001
# MODEL_BUILD=claude-sonnet-5
# MODEL_REVIEW=claude-sonnet-5

# --- Business-system integrations (Section 6/7) ---
# Nothing wired in yet -- this instance has no defined workflows until
# Diego specifies what Quinta55 Reserve actually needs (see TODO in
# quinta55/CLAUDE.md). Add credentials here per-integration as each one
# gets built, e.g.:
# ACCOUNTING_API_KEY=
# EMAIL_SMTP_CREDENTIALS=

# --- Cost control -- hard spend caps (hermes/cost.py), same discipline as
# the trading instance's Section 5, applied here too. A bug in the cron
# loop or a runaway task hits these ceilings, not an unbounded bill.
QUINTA55_MONTHLY_USD_CAP=20.0
QUINTA55_PER_RUN_USD_CAP=2.0
QUINTA55_MAX_RUNS_PER_DAY=4
